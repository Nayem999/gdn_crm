# The app is served by its own vhost on :8080, whose DocumentRoot is
# public/ — genuinely rooted, not a subdirectory, which is what Livewire
# needs: its update endpoint and script tag are built by hand as
# root-relative strings rather than through Laravel's URL generator, so
# if this app ever perceived /gdn_crm as its own base path, both would
# resolve to the wrong origin and every interactive screen would silently
# stop working (see AppServiceProvider::boot() for the matching fix that
# puts the /gdn_crm prefix back on the URLs the browser actually needs).
#
# So the browser is kept at https://localhost/gdn_crm/ throughout, and
# this file transparently proxies every request through to :8080 instead
# of redirecting to it — [P], not [R] — so the address bar never changes
# and nothing here is fetchable as a raw file (.env, composer.json,
# vendor/, app/, storage/ all live in this same directory).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache's own directory-index handling (looking for index.html, then
    # index.php, ...) probes each candidate via an internal *subrequest*
    # against this same directory — which would otherwise re-enter the rule
    # below and proxy the probe itself, so mod_dir ends up believing
    # whatever /index.html returns on the backend (its own 404 page) *is*
    # this directory's index. Excluding subrequests is what stops that.
    RewriteCond %{IS_SUBREQ} false
    RewriteRule ^(.*)$ http://localhost:8080/$1 [P,L]
</IfModule>

# Belt and braces for a server with mod_rewrite or mod_proxy off, where the
# proxy above is skipped and this directory would be served exactly as it
# stands.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
